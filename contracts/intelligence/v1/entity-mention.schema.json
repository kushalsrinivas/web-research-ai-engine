{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wre.dev/schemas/intelligence/v1/entity-mention.schema.json",
  "title": "Entity mention",
  "type": "object",
  "required": [
    "entity_id", "entity_type", "surface_form", "char_start", "char_end",
    "confidence", "extractor_version"
  ],
  "additionalProperties": true,
  "properties": {
    "entity_id": {"type": "string", "minLength": 1},
    "entity_type": {
      "type": "string",
      "enum": [
        "person", "organization", "government", "location", "product", "industry",
        "technology", "financial_instrument", "project", "policy", "event", "work",
        "concept", "other"
      ]
    },
    "surface_form": {"type": "string", "minLength": 1},
    "char_start": {"type": "integer", "minimum": 0},
    "char_end": {"type": "integer", "minimum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "extractor_version": {"type": "string", "minLength": 1}
  }
}
