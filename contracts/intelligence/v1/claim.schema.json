{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wre.dev/schemas/intelligence/v1/claim.schema.json",
  "title": "Extracted claim",
  "type": "object",
  "required": [
    "document_id", "revision", "claim_type", "subject_text", "predicate",
    "claim_text", "quote", "char_start", "char_end", "span_verified",
    "modality", "commitment_status", "extraction_confidence",
    "claim_support_confidence", "extractor_version"
  ],
  "additionalProperties": true,
  "properties": {
    "claim_id": {"type": "string"},
    "document_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "claim_type": {"type": "string", "minLength": 1},
    "subject_entity_id": {"type": ["string", "null"]},
    "subject_text": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object_entity_id": {"type": ["string", "null"]},
    "object_literal": {"type": ["string", "null"]},
    "object_datatype": {"type": ["string", "null"]},
    "polarity": {"type": "string", "enum": ["asserts", "denies"]},
    "claim_text": {"type": "string", "minLength": 1},
    "quote": {"type": "string", "minLength": 1},
    "char_start": {"type": "integer", "minimum": 0},
    "char_end": {"type": "integer", "minimum": 1},
    "span_verified": {"type": "boolean"},
    "paragraph_index": {"type": ["integer", "null"]},
    "sentence_index": {"type": ["integer", "null"]},
    "modality": {
      "type": "string",
      "enum": ["confirmed", "announced", "planned", "proposed", "expected", "alleged", "estimated"]
    },
    "commitment_status": {
      "type": "string",
      "enum": [
        "announced", "planned", "proposed", "approved", "funded", "under_construction",
        "operational", "completed", "expected", "alleged", "estimated"
      ]
    },
    "temporal_qualifier": {"type": ["string", "null"]},
    "amount": {"type": ["number", "null"]},
    "currency": {"type": ["string", "null"]},
    "amount_original": {"type": ["string", "null"]},
    "location_text": {"type": ["string", "null"]},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "entity_resolution_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "claim_support_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "extractor_version": {"type": "string", "minLength": 1}
  }
}
