{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wre.dev/schemas/events/v1/payloads/document.scheduled.schema.json",
  "title": "document.scheduled payload",
  "type": "object",
  "required": ["lane", "priority", "not_before", "robots_hash", "crawl_delay_ms", "is_recrawl"],
  "additionalProperties": true,
  "properties": {
    "lane": {"type": "string", "enum": ["interactive", "bulk"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "not_before": {"type": "string", "format": "date-time"},
    "robots_hash": {"type": "string", "minLength": 1},
    "crawl_delay_ms": {"type": "integer", "minimum": 0},
    "is_recrawl": {"type": "boolean"}
  }
}
