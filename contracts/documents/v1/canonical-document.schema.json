{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wre.dev/schemas/documents/v1/canonical-document.schema.json",
  "title": "Canonical document",
  "description": "Cleaned, normalized representation of one raw document revision. Extraction warnings and quality scores travel with the document so a failed extraction is never silently promoted.",
  "type": "object",
  "required": [
    "document_id",
    "revision",
    "tenant_id",
    "canonical_url",
    "original_url",
    "title",
    "content",
    "language",
    "language_confidence",
    "document_type",
    "author",
    "retrieved_at",
    "content_hash",
    "raw_object_uri",
    "parsed_object_uri",
    "processing_version",
    "parser_version",
    "normalizer_version",
    "metadata",
    "warnings",
    "quality"
  ],
  "additionalProperties": true,
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "source_id": {
      "type": ["string", "null"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "minLength": 1
    },
    "original_url": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "language_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "array",
      "items": {"type": "string"}
    },
    "published_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_object_uri": {
      "type": "string",
      "minLength": 1
    },
    "parsed_object_uri": {
      "type": "string",
      "minLength": 1
    },
    "processing_version": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "normalizer_version": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "quality": {
      "type": "object",
      "required": ["score", "dimensions"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "dimensions": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "reasons": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object"
    }
  }
}
