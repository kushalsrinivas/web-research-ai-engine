# Copy to .env for local overrides. Never commit .env or real secrets.
# Staging/production values come from the platform secret manager.

APP_ENV=development
VERSION=dev
IMAGE_PREFIX=wre
TAG=dev
LOG_LEVEL=info
OTEL_SAMPLE_RATIO=1.0

POSTGRES_USER=wre
POSTGRES_PASSWORD=wre
POSTGRES_DB=wre
# Host mapping only; containers always use 5432. Change if a local PostgreSQL owns 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgres://wre:wre@postgres:5432/wre?sslmode=disable

S3_ACCESS_KEY=wre
S3_SECRET_KEY=wre-secret
S3_BUCKET_RAW=wre-raw
S3_BUCKET_PARSED=wre-parsed
S3_BUCKET_ENRICHED=wre-enriched
S3_ENDPOINT=http://silo:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001

KAFKA_BROKERS=redpanda:9092
TEMPORAL_HOST=temporal:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
REDPANDA_CONSOLE_PORT=8090

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
TEMPO_PORT=3200

FETCHER_MAX_CONCURRENCY=20
FETCHER_TIMEOUT_SECONDS=30

DISCOVERY_PROVIDER=gdelt
SOURCE_USER_AGENT=wre-source-registry/0.1 (+https://github.com/kushalsrinivas/web-research-ai-engine)

# Only llm-gateway receives provider credentials.
LLM_PROVIDER=stub
LLM_MODEL=stub
LLM_API_KEY=
